# Copy to .env (local) and set the same names in Vercel project settings.

# Neon Postgres
DATABASE_URL=                 # Neon pooled connection (…-pooler…)
DIRECT_URL=                   # Neon direct connection (used by migrations)

# Auth
BETTER_AUTH_SECRET=           # openssl rand -base64 32
APP_URL=                      # e.g. https://reviews.yourdomain.co.za (no trailing slash)

# Email (Resend). Without RESEND_API_KEY, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=                   # e.g. "Reviews <reviews@yourdomain.co.za>"
ENQUIRY_TO_EMAIL=             # where public enquiries are sent (defaults to ADMIN_EMAIL)

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=        # any random string; also entered in the Meta webhook settings
WHATSAPP_APP_SECRET=          # verifies webhook signatures
WHATSAPP_TEMPLATE_REQUEST=review_request    # approved template names
WHATSAPP_TEMPLATE_REMINDER=review_reminder
WHATSAPP_TEMPLATE_LANG=en
NEXT_PUBLIC_WHATSAPP_CONTACT= # optional: digits only, e.g. 27821234567 for the contact page link

# Inngest (background jobs). Locally run: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Redis (rate limiting). Without these, an in-memory limiter is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seeds the first platform admin (npm run db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=               # optional; if empty the seed prints a generated password

# Demo client logins (npm run db:seed:demo). Never run the demo seed against production.
DEMO_PASSWORD=

# Tests only: a SEPARATE throwaway database (tests delete all data). Locally: npx prisma dev -n nostalgic-test
TEST_DATABASE_URL=

# Optional / advanced
WHATSAPP_API_VERSION=         # defaults to a recent Graph API version; set only to pin one
INNGEST_DEV=                  # set to 1 only for local Inngest dev (npx inngest-cli@latest dev)
DISABLE_RATE_LIMIT=           # set to 1 only to switch rate limiting off (never in production)

# Optional: your Inngest plan's monthly executions limit (see the Inngest dashboard). Used for the warning on /admin/usage. Default 50000.
INNGEST_MONTHLY_EXECUTIONS=
